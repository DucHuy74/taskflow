type GraphNode {
    id: ID!
    label: String!
    # SUBJECT | ACTION | OBJECT when a term has exactly one role, TERM when mixed/unknown, USER_STORY for stories
    type: String!

    # ===== Term analytics (null when the analyzer has not written them) =====
    degree: Int
    betweenness: Float
    # Union of :Subject/:Action/:Object labels and PERFORM/TARGET edge-derived roles in the current filter scope.
    # Always [] for USER_STORY nodes.
    roles: [String!]!

    # ===== User story fields (null for terms) =====
    priority: Float
    graphRelevanceScore: Float
    duplicateScore: Float
}

type GraphEdge {
    from: ID!
    to: ID!
    # PERFORM | TARGET | SIMILAR | ASSOCIATED | RELATES_TO
    type: String!

    # ===== Analytics =====
    score: Float
    confidence: Float
    lift: Float

    # ===== Context =====
    # First of storyIds (kept for older clients)
    storyId: ID
    # Distinct stories contributing to an aggregated PERFORM/TARGET edge ([] for SIMILAR/ASSOCIATED)
    storyIds: [ID!]
    # Number of distinct stories (PERFORM/TARGET only)
    weight: Int
    # Echo of the sprintId/backlogId filter when provided, else null
    sprintId: ID
    backlogId: ID

    # REALTIME | BATCH; null when the aggregated rows have mixed sources. SIMILAR/ASSOCIATED are always BATCH.
    source: String
}

type GraphResponse {
    nodes: [GraphNode!]!
    edges: [GraphEdge!]!
}

type Query {
    workspaceGraph(
        workspaceId: ID!

        # ===== Context filter =====
        # sprintId: stories currently in that sprint (must belong to workspaceId, else NOT_FOUND).
        # backlogId (ignored when sprintId is set): stories of the workspace that are in no sprint.
        # Story ids come from MySQL; PERFORM/TARGET/RELATES_TO edges are limited to those stories, and
        # SIMILAR/ASSOCIATED edges to pairs of terms that both appear in the scoped PERFORM/TARGET edges.
        sprintId: ID
        backlogId: ID

        # ===== Source filter =====
        # null = all sources. REALTIME | BATCH filters only PERFORM/TARGET edges (and the nodes reached through them);
        # SIMILAR/ASSOCIATED are never filtered by source. Any other value is a BAD_REQUEST error.
        source: String

        # ===== Feature toggle =====
        includeSimilarity: Boolean = true
        includeAssociation: Boolean = true

        # ===== Analytics filter =====
        minScore: Float = 0.0
        minConfidence: Float = 0.0
    ): GraphResponse
}
